# Public configuration: these values are bundled into browser assets.
# Canonical HTTPS origin for production builds. For npm run dev, localhost is allowed.
NEXT_PUBLIC_SITE_URL=https://certs.uzyntra.com
# Required together for authentication and Vercel Production deployment.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only: required for the registration email lookup; never expose to browsers.
SUPABASE_SECRET_KEY=
# Never put service-role keys, database passwords, or access tokens in NEXT_PUBLIC_*.
# VERCEL and VERCEL_ENV are managed by Vercel; do not manually override them there.
